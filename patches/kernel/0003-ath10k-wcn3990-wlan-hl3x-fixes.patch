+/*
+ * WLAN.HL.3.x on WCN3990 answers vdev-start with status -1 unless the peer for
+ * the AP (BSSID) already exists. mac80211 assigns the chanctx before it adds
+ * the AP station, so remember the channel and start the vdev from sta_state.
+ */
+static bool ath10k_wcn3990_delay_vdev_start(struct ath10k *ar,
+					    struct ieee80211_vif *vif)
+{
+	return QCA_REV_WCN3990(ar) && vif->type == NL80211_IFTYPE_STATION &&
+	       !vif->p2p;
+}
+
+static int ath10k_mac_finish_delayed_vdev_start(struct ath10k_vif *arvif)
+{
+	struct ath10k *ar = arvif->ar;
+	int ret;
+
+	if (!arvif->vdev_start_delayed)
+		return 0;
+
+	arvif->vdev_start_delayed = false;
+	ret = ath10k_vdev_start(arvif, &arvif->delayed_chandef);
+	if (ret)
+		ath10k_warn(ar, "failed to start delayed vdev %i on freq %d: %d\n",
+			    arvif->vdev_id,
+			    arvif->delayed_chandef.chan->center_freq, ret);
+	return ret;
+}
