diff --git a/src/overview.c b/src/overview.c
index 8df50c7..10adc94 100644
--- a/src/overview.c
+++ b/src/overview.c
@@ -21,9 +21,15 @@
 #include "util.h"
 
 #include <gio/gdesktopappinfo.h>
+#include <glib/gstdio.h>
 
 #include <handy.h>
 
+#include <signal.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
 #define OVERVIEW_ICON_SIZE 64
 
 /**
@@ -321,6 +327,99 @@ on_activity_clicked (PhoshOverview *self, PhoshActivity *activity)
 }
 
 
+/*
+ * willow: force-close apps that ignore the close request.
+ * 3 s after asking a toplevel to close, if it is still alive, kill the user's
+ * processes whose argv[0] matches the app's .desktop Exec (or app-id tail).
+ */
+typedef struct {
+  GWeakRef  toplevel;
+  char     *app_id;
+} ForceCloseData;
+
+
+static void
+force_close_data_free (gpointer data)
+{
+  ForceCloseData *fc = data;
+
+  g_weak_ref_clear (&fc->toplevel);
+  g_free (fc->app_id);
+  g_free (fc);
+}
+
+
+static char *
+force_close_get_exe_name (const char *app_id)
+{
+  g_autoptr (GDesktopAppInfo) info = phosh_get_desktop_app_info_for_app_id (app_id);
+  const char *exe = info ? g_app_info_get_executable (G_APP_INFO (info)) : NULL;
+  const char *dot;
+
+  if (exe && *exe)
+    return g_path_get_basename (exe);
+
+  dot = strrchr (app_id, '.');
+  return g_ascii_strdown (dot ? dot + 1 : app_id, -1);
+}
+
+
+static void
+force_close_kill (const char *app_id)
+{
+  g_autofree char *exe = force_close_get_exe_name (app_id);
+  g_autoptr (GDir) dir = g_dir_open ("/proc", 0, NULL);
+  const char *name;
+  uid_t uid = getuid ();
+  pid_t self_pid = getpid ();
+
+  if (!dir || !exe || !*exe)
+    return;
+
+  while ((name = g_dir_read_name (dir))) {
+    g_autofree char *proc_path = NULL, *cmdline_path = NULL, *cmdline = NULL;
+    g_autofree char *argv0 = NULL;
+    GStatBuf st;
+    gsize len = 0;
+    pid_t pid;
+
+    if (!g_ascii_isdigit (name[0]))
+      continue;
+    pid = (pid_t) g_ascii_strtoll (name, NULL, 10);
+    if (pid == self_pid)
+      continue;
+
+    proc_path = g_build_filename ("/proc", name, NULL);
+    if (g_stat (proc_path, &st) != 0 || st.st_uid != uid)
+      continue;
+
+    cmdline_path = g_build_filename ("/proc", name, "cmdline", NULL);
+    if (!g_file_get_contents (cmdline_path, &cmdline, &len, NULL) || len == 0)
+      continue;
+
+    argv0 = g_path_get_basename (cmdline);
+    if (g_strcmp0 (argv0, exe) == 0) {
+      g_message ("Force closing %s (pid %d, %s)", app_id, pid, exe);
+      kill (pid, SIGKILL);
+    }
+  }
+}
+
+
+static gboolean
+force_close_timeout_cb (gpointer data)
+{
+  ForceCloseData *fc = data;
+  g_autoptr (PhoshToplevel) toplevel = g_weak_ref_get (&fc->toplevel);
+
+  /* still around after the close request: the app ignored it */
+  if (toplevel)
+    force_close_kill (fc->app_id);
+
+  return G_SOURCE_REMOVE;
+}
+
+
 static void
 on_activity_closed (PhoshOverview *self, PhoshActivity *activity)
 {
@@ -338,6 +437,16 @@ on_activity_closed (PhoshOverview *self, PhoshActivity *activity)
 
   phosh_toplevel_close (toplevel);
   phosh_trigger_feedback ("window-close", FALSE);
+
+  if (phosh_activity_get_app_id (activity)) {
+    ForceCloseData *fc = g_new0 (ForceCloseData, 1);
+
+    g_weak_ref_init (&fc->toplevel, toplevel);
+    fc->app_id = g_strdup (phosh_activity_get_app_id (activity));
+    g_timeout_add_seconds_full (G_PRIORITY_DEFAULT, 3, force_close_timeout_cb, fc,
+                                force_close_data_free);
+  }
+
   g_signal_emit (self, signals[ACTIVITY_CLOSED], 0);
 }
 
