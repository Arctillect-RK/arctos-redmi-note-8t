+/*
+ * ArctOS home screen: apps are laid out row by row on pages of
+ * ARCTOS_PAGE_COLS x ARCTOS_PAGE_ROWS buttons inside a HdyCarousel, which
+ * provides the sideways swipe with snapping and the page indicator dots.
+ * The original flowbox stays bound (hidden) for search focus and folder lookups.
+ */
+static void
+arctos_rebuild_pages (PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  g_autoptr (GList) old_pages = NULL;
+  GtkWidget *grid = NULL;
+  guint n_items, per_page = ARCTOS_PAGE_COLS * ARCTOS_PAGE_ROWS;
+
+  old_pages = gtk_container_get_children (GTK_CONTAINER (priv->pages));
+  for (GList *l = old_pages; l; l = l->next)
+    gtk_container_remove (GTK_CONTAINER (priv->pages), GTK_WIDGET (l->data));
+
+  n_items = g_list_model_get_n_items (G_LIST_MODEL (priv->model));
+  for (guint i = 0; i < n_items; i++) {
+    g_autoptr (GObject) item = g_list_model_get_item (G_LIST_MODEL (priv->model), i);
+    guint slot = i % per_page;
+    GtkWidget *btn;
+
+    if (slot == 0) {
+      grid = gtk_grid_new ();
+      gtk_grid_set_column_homogeneous (GTK_GRID (grid), TRUE);
+      gtk_grid_set_row_spacing (GTK_GRID (grid), 6);
+      gtk_widget_set_hexpand (grid, TRUE);
+      gtk_widget_set_valign (grid, GTK_ALIGN_START);
+      gtk_style_context_add_class (gtk_widget_get_style_context (grid), "arctos-page");
+      gtk_widget_set_visible (grid, TRUE);
+      hdy_carousel_insert (HDY_CAROUSEL (priv->pages), grid, -1);
+    }
+
+    btn = create_launcher (item, self);
+    gtk_grid_attach (GTK_GRID (grid), btn, slot % ARCTOS_PAGE_COLS, slot / ARCTOS_PAGE_COLS, 1, 1);
+  }
+
+  /* keep empty columns of the first row so a page with 1-3 apps is not stretched */
+  if (n_items > 0 && n_items < ARCTOS_PAGE_COLS && grid) {
+    for (guint c = n_items; c < ARCTOS_PAGE_COLS; c++) {
+      GtkWidget *spacer = gtk_label_new (NULL);
+
+      gtk_widget_set_visible (spacer, TRUE);
+      gtk_grid_attach (GTK_GRID (grid), spacer, c, 0, 1, 1);
+    }
+  }
+}
+
+
+static gboolean
+arctos_rebuild_pages_idle (gpointer data)
+{
+  PhoshAppGrid *self = PHOSH_APP_GRID (data);
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  priv->pages_idle_id = 0;
+  arctos_rebuild_pages (self);
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+arctos_queue_rebuild_pages (PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  if (priv->pages_idle_id == 0)
+    priv->pages_idle_id = g_idle_add (arctos_rebuild_pages_idle, self);
+}
+
+
+static void
+arctos_scroll_to_first_page (PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  g_autoptr (GList) pages = gtk_container_get_children (GTK_CONTAINER (priv->pages));
+
+  if (pages)
+    hdy_carousel_scroll_to_full (HDY_CAROUSEL (priv->pages), GTK_WIDGET (pages->data), 0);
+}
+
+
+static void
+arctos_setup_paging (PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  /* the flowbox is only kept for search focus / folder index lookups */
+  gtk_widget_set_visible (priv->scrolled_window, FALSE);
+  /* "Show all apps" toggle makes no sense with fixed pages: always show everything */
+  gtk_widget_set_visible (priv->btn_adaptive, FALSE);
+
+  g_signal_connect_swapped (priv->model, "items-changed",
+                            G_CALLBACK (arctos_queue_rebuild_pages), self);
+  arctos_rebuild_pages (self);
+}
+
+
 static void
 phosh_app_grid_init (PhoshAppGrid *self)
 {
@@ -457,6 +566,7 @@ phosh_app_grid_init (PhoshAppGrid *self)
                            create_launcher,
                            self,
                            NULL);
+  arctos_setup_paging (self);
 
   priv->settings = g_settings_new ("sm.puri.phosh");
   g_object_connect (priv->settings,
@@ -484,6 +594,7 @@ phosh_app_grid_dispose (GObject *object)
   g_clear_object (&priv->actions);
   g_clear_object (&priv->model);
   g_clear_object (&priv->settings);
+  g_clear_handle_id (&priv->pages_idle_id, g_source_remove);
   g_clear_handle_id (&priv->debounce, g_source_remove);
 
   G_OBJECT_CLASS (phosh_app_grid_parent_class)->dispose (object);
@@ -530,6 +641,7 @@ do_search (gpointer data)
